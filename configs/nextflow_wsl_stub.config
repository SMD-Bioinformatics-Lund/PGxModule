// Load after configs/nextflow.config. These synthetic inputs require -stub-run.
params {
    csv = "${projectDir}/.design/samplesheet.csv"
    resultsdir = "${projectDir}/.design/results"
    outdir = "${projectDir}/.design/results"
    subdir = 'pgx_stub'
    crondir = "${projectDir}/.design/cron"
    reports_path = "${projectDir}/.design/results/pgx_stub/reports"
    genome_file = "${projectDir}/.design/inputs/genome.fa"
    GENOMEDICT = "${projectDir}/.design/inputs/genome.dict"
    gene_regions = "${projectDir}/.design/inputs/genes.bed"
    pgx_target_regions = "${projectDir}/.design/inputs/targets.bed"
    pgx_target_rsid = "${projectDir}/.design/inputs/targets.bed"
    dbSNP = "${projectDir}/.design/inputs/dbsnp.vcf"
    dbSNP_version = 'STUB'
    ref_version = 'SYNTHETIC'
    addchr = 'False'
    pharmcat = false
    haplotype_caller = 'SENTIEON'
}

workDir = "${projectDir}/.design/work"
singularity {
    enabled = true
    autoMounts = true
    runOptions = "--bind ${projectDir}"
}
executor.name = 'local'
process {
    executor = 'local'
    queue = null
    // Override cluster resource requests and publication paths for local runs.
    withName: '.*' {
        cpus = 1
        memory = 1.GB
        time = 10.m
        publishDir = [
            path: { "${params.outdir}/${params.subdir}/${task.process.tokenize(':')[-1]}" },
            mode: 'copy', overwrite: true
        ]
    }
}
trace.file = "${projectDir}/.design/trace.txt"
report.file = "${projectDir}/.design/execution_report.html"
timeline.file = "${projectDir}/.design/timeline.html"
